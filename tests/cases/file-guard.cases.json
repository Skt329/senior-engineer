      "expect": "deny"
    },
    {
      "tool": "Read",
      "path": "backend/.env.production",
      "expect": "deny"
    },
    {
      "tool": "Read",
      "path": "C:\\Users\\me\\repo\\.env.local",
      "expect": "deny"
