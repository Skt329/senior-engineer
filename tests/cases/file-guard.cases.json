    {
      "tool": "Read",
      "path": "config/.env.sample",
      "expect": "none"
    },
    {
      "tool": "Read",
      "path": ".env.local.template",
      "expect": "none"
    },
    {
      "tool": "Read",
      "path": "keys/server.pem",
      "expect": "deny"
